# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# INTEGRATION PLACEHOLDERS (Replace with your actual keys when ready)
# ==============================================================================

# 1. USER AUTHENTICATION PLACEHOLDERS
# Replace with your Firebase Auth, Supabase, or OAuth credentials
VITE_AUTH_PROVIDER="placeholder" # Options: firebase, supabase, custom_oauth
VITE_AUTH_DOMAIN="as-studio-auth.placeholder.local"
VITE_AUTH_CLIENT_ID="placeholder_auth_client_id_xxxxxx"
AUTH_JWT_SECRET="placeholder_jwt_secret_key_change_me_later"

# 2. DATABASE STORAGE PLACEHOLDERS
# Replace with your PostgreSQL, Cloud SQL, Supabase, or Firestore URI
VITE_DATABASE_URL="postgresql://user:password@localhost:5432/as_studio_db"
DATABASE_DIALECT="postgres" # Options: postgres, cloudsql, supabase, firestore
DATABASE_POOL_MAX=10

# 3. GMAIL & EMAIL SERVICE PLACEHOLDERS
# Replace with your Google Workspace Gmail API credentials or SMTP settings
VITE_GMAIL_CLIENT_ID="placeholder_gmail_client_id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="placeholder_gmail_client_secret_xxxxxx"
GMAIL_REFRESH_TOKEN="placeholder_gmail_refresh_token_xxxxxx"
GMAIL_SENDER_ADDRESS="asbusinessofficial01@gmail.com"
